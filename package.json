{
  "name": "dsh-batch-uninstall",
  "version": "1.3.0",
  "description": "Geek 风格 DSH 工具箱：批量卸载插件、批量删除工作区（软删除到回收站）、回收站管理，核心系统插件自动锁定保护。A Geek-style DSH toolbox: batch plugin uninstall, batch workspace delete (soft-delete to trash) and trash management.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "MaYucong6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaYucong6/dsh-batch-uninstall.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "plugin-manager",
    "uninstall",
    "uninstaller",
    "batch"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "dsh_plugins.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
